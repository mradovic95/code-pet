@startuml code-pet-states
skinparam state {
  BackgroundColor<<looping>> #D4E6F1
  BackgroundColor<<oneshot>> #FADBD8
}

title Code Pet — State Machine

[*] --> waking_up : SessionStart\n//awaken//\n(only when zero state)

state "idle" as idle <<looping>> : Looping (4 frames, 1600ms)
state "waking_up" as waking_up <<oneshot>> : One-shot (20 frames, 4000ms)
state "working" as working <<looping>> : Looping (4 frames, 1200ms)
state "planning" as planning <<looping>> : Looping (4 frames, 1200ms)
state "waiting_for_action" as waiting_for_action <<looping>> : Looping (4 frames, 1600ms)

' ── Hook-driven transitions (any state → target) ──
idle --> working : UserPromptSubmit\n//working_started//
idle --> waiting_for_action : Notification\n//action_requested//
idle --> planning : UserPromptSubmit (plan)\n//planning_started//

' ── Stop returns to idle from active states ──
working -[#red]-> idle : Stop\n//work_finished//
planning -[#red]-> idle : Stop\n//work_finished//

' ── Auto-transitions (timeouts) ──
waking_up -[#green,dashed]-> idle : auto\n4000ms

' ── Awaken suppressed during ALL non-zero states ──
working -[#grey,dotted]-> working : SessionStart\n//awaken// (suppressed)
planning -[#grey,dotted]-> planning : SessionStart\n//awaken// (suppressed)
waiting_for_action -[#grey,dotted]-> waiting_for_action : SessionStart\n//awaken// (suppressed)

' ── falling_asleep restores previous active state from waiting_for_action ──
waiting_for_action -[#blue,dashed]-> working : SessionEnd\n//falling_asleep//\n(restore)
waiting_for_action -[#blue,dashed]-> planning : SessionEnd\n//falling_asleep//\n(restore)

' ── question_answered restores previous active state ──
waiting_for_action -[#purple,dashed]-> working : PostToolUse(AskUserQuestion)\n//question_answered//\n(restore)
waiting_for_action -[#purple,dashed]-> planning : PostToolUse(AskUserQuestion)\n//question_answered//\n(restore)

' ── waiting_for_action exits via UserPromptSubmit ──
waiting_for_action --> working : UserPromptSubmit\n//working_started//
waiting_for_action --> planning : UserPromptSubmit (plan)\n//planning_started//

note right of idle
  Any event can arrive in **any** state.
  Transitions shown from idle for clarity,
  but the pet accepts all events regardless
  of current state (no guards), except:
  **awaken** is suppressed whenever
  lastActiveEvent is set or lastEventName
  is action_requested (any non-zero state).
  **falling_asleep** restores from
  waiting_for_action, is suppressed during
  active work, or is tracked for shutdown.
  Debounce: 300ms collapses rapid events.
end note

@enduml


@startuml code-pet-events
title Code Pet — Hook Events to States

skinparam componentStyle rectangle

package "Claude Code Hooks" {
  [SessionStart] as SS
  [SessionEnd] as SE
  [UserPromptSubmit] as PS
  [Notification] as NOTIF
  [PostToolUse] as PTU
  [Stop] as STOP
}

package "Pet States" {
  [waking_up] #FADBD8
  [working] #D4E6F1
  [planning] #D4E6F1
  [waiting_for_action] #D4E6F1
  [idle] #D4E6F1
}

SS --> [waking_up] : when zero state
SE --> [working] : restore from\nwaiting_for_action
SE --> [planning] : restore from\nwaiting_for_action
PS --> [working] : normal mode
PS --> [planning] : plan mode
NOTIF --> [waiting_for_action] : permission_prompt
PTU --> [working] : AskUserQuestion\n(restore)
PTU --> [planning] : AskUserQuestion\n(restore)
STOP --> [idle] : always

note bottom of SS
  //awaken// suppressed when pet has
  any active state (working, planning,
  waiting_for_action). Only fires
  waking_up when pet is idle/fresh.
end note

note bottom of SE
  //falling_asleep// restores from
  waiting_for_action; suppressed during
  active work; tracked for shutdown
  when pet has no active state.
end note

legend right
  | Color | Meaning |
  | <#D4E6F1> | Looping state |
  | <#FADBD8> | One-shot state |
end legend

@enduml
